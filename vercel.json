{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python -m src.build_site",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "{site/**,sql/**,config/**}",
      "excludeFiles": "{tests/**,docs/**,web/**,build/**,data/**,.venv/**,.github/**,db/**}"
    }
  }
}
